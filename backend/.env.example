# development | production. En production la app NO arranca con un JWT_SECRET débil.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dayflow.db
# Production (Neon): postgresql://<user>:<password>@<host>/<db>?sslmode=require
# Generar uno: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
